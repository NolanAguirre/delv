{
  "name": "delv",
  "version": "0.9.0",
  "description": "A light weight caching library for graphql queries",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./react": "./src/react/delv-react.js"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "src/",
    "README.md",
    "docs/cache-design.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NolanAguirre/delv.git"
  },
  "keywords": [
    "graphql",
    "cache",
    "postgraphile",
    "react"
  ],
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__test__/environment/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/networkPolicy/Polling.js",
      "!src/core/Mutation.js",
      "!src/cache/policy/Query.js",
      "!src/index.js"
    ]
  },
  "author": "Nolan Aguirre",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NolanAguirre/delv/issues"
  },
  "homepage": "https://github.com/NolanAguirre/delv#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^0.21.2",
    "graphql": "^14.4.2",
    "graphql-anywhere": "^4.1.24",
    "graphql-tag": "^2.10.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.5",
    "@babel/node": "^7.4.5",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/preset-env": "^7.4.5",
    "@babel/preset-react": "^7.29.7",
    "jest": "^24.9.0",
    "react": "^17.0.2",
    "react-test-renderer": "^17.0.2"
  }
}
